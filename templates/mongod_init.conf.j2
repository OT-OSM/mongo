# mongod.conf — TEMPORARY bootstrap config (no auth)
# Used only during initial replica set / user creation. The mongodb_server
# role automatically restores the full mongod.conf.j2 afterwards.

systemLog:
  destination: {{ mongo_systemlog_destination }}
  logAppend: true
  path: {{ mongo_systemlog_path }}

storage:
  dbPath: {{ mongo_db_path }}

net:
  port: {{ mongo_port }}
  bindIp: 0.0.0.0

{% if mongodb_replication | default(false) %}
replication:
  replSetName: {{ mongo_replSetName }}
{% endif %}
